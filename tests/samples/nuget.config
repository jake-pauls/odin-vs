<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Samples restore Odin.Sdk from the repo's local-only feed (nuget/README.md; run scripts\pack-sdk.ps1 first); clear drops nuget.org from the sources. -->
  <packageSources>
    <clear />
    <add key="local-odin" value="..\..\nuget" />
  </packageSources>
</configuration>
