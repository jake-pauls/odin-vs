<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup>
    <VsExtensionsDir>$(VsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\</VsExtensionsDir>
    <CpsDir>$(VsExtensionsDir)Project\</CpsDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <!-- CPS assemblies come from the VS install (public NuGet packages stop at 17.9.380); never ship them. -->
    <Reference Include="Microsoft.VisualStudio.ProjectSystem">
      <HintPath>$(CpsDir)Microsoft.VisualStudio.ProjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.ProjectSystem.VS">
      <HintPath>$(CpsDir)Microsoft.VisualStudio.ProjectSystem.VS.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- CPS 18.x is built against System.Collections.Immutable 10.0; the VS SDK 17.14 packages bring 9.0. Compile against VS's copy. -->
    <PackageReference Include="System.Collections.Immutable" Version="9.0.0" ExcludeAssets="compile;runtime" />
    <Reference Include="System.Collections.Immutable">
      <HintPath>$(VsExtensionsDir)VBCSharp\LanguageServices\InteractiveHost\Desktop\System.Collections.Immutable.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Same story for Microsoft.VisualStudio.Threading: CPS 18.x is built against 18.7, the VS SDK packages bring 17.14 (CS1705 once a CPS type that
         touches threading is used). Compile against the copy VS ships in PublicAssemblies. -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Only" Version="17.14.15" ExcludeAssets="compile;runtime" />
    <Reference Include="Microsoft.VisualStudio.Threading">
      <HintPath>$(VsInstallRoot)\Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Threading.17.x\Microsoft.VisualStudio.Threading.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.0" ExcludeAssets="compile;runtime" />
    <Reference Include="System.Threading.Tasks.Extensions">
      <HintPath>$(VsInstallRoot)\Common7\IDE\PublicAssemblies\System.Threading.Tasks.Extensions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Dataflow (the project subscription blocks): CPS 18.x is built against 10.0, the VS SDK packages bring 9.0 (CS1705). Compile against VS's copy. -->
    <PackageReference Include="System.Threading.Tasks.Dataflow" Version="9.0.0" ExcludeAssets="compile;runtime" />
    <Reference Include="System.Threading.Tasks.Dataflow">
      <HintPath>$(VsExtensionsDir)VBCSharp\LanguageServices\InteractiveHost\Desktop\System.Threading.Tasks.Dataflow.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OdinVS.Core\OdinVS.Core.csproj" />
    <ProjectReference Include="..\OdinVS.LanguageServer\OdinVS.LanguageServer.csproj" />
  </ItemGroup>
</Project>
