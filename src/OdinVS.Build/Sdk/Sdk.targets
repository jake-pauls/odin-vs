<Project>
  <!-- Design-time wiring CPS needs for a custom project type (see spikes/cps-feasibility/FINDINGS.md), plus the real command-line build.
       The BrowseObject rule is what fixes "missing some critical imports": CPS throws that error when no
       PropertyPageSchema with Context BrowseObject exists (see PhysicalProjectTreeProvider.GetProjectRootProperties). -->
  <PropertyGroup>
    <OdinRulesDir>$(MSBuildThisFileDirectory)Rules\</OdinRulesDir>
  </PropertyGroup>

  <UsingTask TaskName="OdinVS.Core.OdinBuild" AssemblyFile="$(MSBuildThisFileDirectory)tools\OdinVS.Core.dll" />

  <!-- CPS reads ProjectConfiguration metadata unevaluated: metadata built from item transforms, property functions or $(Platform)
       showed up as literal text in the Configuration Manager (found in Exp 2026-11-01). So the metadata must be literal values, and
       only Debug and Release (x64) can be declared, each included when the project's Configurations list contains it. -->
  <ItemGroup>
    <ProjectConfiguration Include="Debug|x64" Condition="$([System.String]::Copy(';$(Configurations);').Contains(';Debug;'))">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64" Condition="$([System.String]::Copy(';$(Configurations);').Contains(';Release;'))">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <ItemGroup>
    <ProjectCapability Include="OdinProject" />
    <ProjectCapability Include="ProjectConfigurationsDeclaredAsItems" />
    <!-- C# declares this so CPS tracks glob-included files and re-evaluates when files change on disk. -->
    <ProjectCapability Include="UseFileGlobs" />
    <!-- Same switch C# sets: our own [ExportDebugger] provider is used instead of VS's built-in Windows Local Debugger. -->
    <ProjectCapability Include="DisableBuiltInDebuggerServices" />
    <!-- References (M6). ProjectReferences enables VS's own project-reference services: the Projects tab of Add Reference, writing the
         ProjectReference item, solution build ordering and VS's circular-reference check (decompiled from the VS 18 project system).
         DependenciesTree is what makes the Add Reference command appear in Solution Explorer. -->
    <ProjectCapability Include="ProjectReferences" />
    <ProjectCapability Include="DependenciesTree" />
  </ItemGroup>

  <PropertyGroup>
    <!-- OdinExe is intentionally not defaulted: empty makes the task search PATH, then C:\Program Files\Odin\odin\dist\odin.exe. Set it in the .odinproj to override. -->
    <OdinPackageDir Condition="'$(OdinPackageDir)' == ''">src</OdinPackageDir>
    <OdinExtraArgs Condition="'$(OdinExtraArgs)' == ''"></OdinExtraArgs>
    <!-- Project-level settings (output location, target name, paths) are defaults a .odinproj can override. Compiler options belong in OdinExtraArgs. -->
    <OutDir Condition="'$(OutDir)' == ''">$(MSBuildProjectDirectory)\bin\$(Configuration)\</OutDir>
    <OutDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)'))</OutDir>
    <TargetName Condition="'$(TargetName)' == ''">$(MSBuildProjectName)</TargetName>
    <!-- What the project builds: Exe (default), Dll or Lib (static library). Selects -build-mode: and the output extension. -->
    <OdinOutputType Condition="'$(OdinOutputType)' == ''">Exe</OdinOutputType>
    <TargetExt Condition="'$(TargetExt)' == '' and '$(OdinOutputType)' == 'Dll'">.dll</TargetExt>
    <TargetExt Condition="'$(TargetExt)' == '' and '$(OdinOutputType)' == 'Lib'">.lib</TargetExt>
    <TargetExt Condition="'$(TargetExt)' == ''">.exe</TargetExt>
    <TargetPath Condition="'$(TargetPath)' == ''">$(OutDir)$(TargetName)$(TargetExt)</TargetPath>
    <TargetPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(TargetPath)'))</TargetPath>
    <!-- odin writes the PDB next to -out: with the same name, so it follows TargetPath and is not a separate setting. -->
    <_OdinPdbPath>$([System.IO.Path]::ChangeExtension('$(TargetPath)', '.pdb'))</_OdinPdbPath>
    <!-- Default: -debug (emits the PDB, implies -o:none) only for the Debug configuration. Set OdinDebug in the .odinproj to change it. -->
    <OdinDebug Condition="'$(OdinDebug)' == '' and '$(Configuration)' == 'Debug'">true</OdinDebug>
    <OdinDebug Condition="'$(OdinDebug)' == ''">false</OdinDebug>
    <!-- Read by VS's built-in "Windows Local Debugger" (applies to CPS projects with the BuildWindowsDesktopTarget capability). -->
    <LocalDebuggerCommand Condition="'$(LocalDebuggerCommand)' == ''">$(TargetPath)</LocalDebuggerCommand>
    <LocalDebuggerWorkingDirectory Condition="'$(LocalDebuggerWorkingDirectory)' == ''">$(MSBuildProjectDirectory)</LocalDebuggerWorkingDirectory>
    <LocalDebuggerDebuggerType Condition="'$(LocalDebuggerDebuggerType)' == ''">Auto</LocalDebuggerDebuggerType>
    <!-- CPS selects the debug launch provider whose [ExportDebugger("<name>")] equals this property. -->
    <DebuggerFlavor Condition="'$(DebuggerFlavor)' == ''">OdinDebugger</DebuggerFlavor>
  </PropertyGroup>

  <!-- A -debug build also produces a PDB, so a missing PDB must trigger a rebuild. -->
  <ItemGroup>
    <_OdinPdbOutput Include="$(_OdinPdbPath)" Condition="'$(OdinDebug)' == 'true'" />
    <!-- A DLL build also writes its import library next to it. -->
    <_OdinImportLibOutput Include="$([System.IO.Path]::ChangeExtension('$(TargetPath)', '.lib'))" Condition="'$(OdinOutputType)' == 'Dll'" />
  </ItemGroup>

  <!-- References. MSBuild/VS order the builds through ProjectReference; the Core resolver (OdinReferenceResolver) does the rest: transitive
       collections for Source references, link inputs for Link references, cycle and duplicate-name errors.
       ProjectReference metadata: ReferenceKind = Source (default for .odinproj) or Link (default for .vcxproj). -->
  <UsingTask TaskName="OdinVS.Core.OdinResolveReferences" AssemblyFile="$(MSBuildThisFileDirectory)tools\OdinVS.Core.dll" />

  <PropertyGroup>
    <!-- Consumers write import "<OdinCollectionName>:<path under OdinCollectionRoot>". -->
    <OdinCollectionName Condition="'$(OdinCollectionName)' == ''">$(MSBuildProjectName)</OdinCollectionName>
    <OdinCollectionRoot Condition="'$(OdinCollectionRoot)' == ''">$(MSBuildProjectDirectory)</OdinCollectionRoot>
    <OdinCollectionRoot>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(OdinCollectionRoot)'))</OdinCollectionRoot>
    <!-- File that Link references of this project link against (empty for projects that produce none). A Dll is linked through the import library odin writes next to it; a Lib is its own link input. -->
    <OdinLinkLibrary Condition="'$(OdinLinkLibrary)' == '' and '$(OdinOutputType)' == 'Dll'">$([System.IO.Path]::ChangeExtension('$(TargetPath)', '.lib'))</OdinLinkLibrary>
    <OdinLinkLibrary Condition="'$(OdinLinkLibrary)' == '' and '$(OdinOutputType)' == 'Lib'">$(TargetPath)</OdinLinkLibrary>
  </PropertyGroup>

  <!-- Returns this project's node plus the nodes of everything it references (MSBuild recurses; results are cached per project, so a
       diamond or a 100-project chain costs one evaluation each). A cycle ends in MSBuild's own circular-dependency error here. -->
  <Target Name="_OdinClassifyReferences">
    <ItemGroup>
      <_OdinOdinRef Include="@(ProjectReference)" Condition="'%(Extension)' == '.odinproj'" />
      <_OdinNativeRef Include="@(ProjectReference)" Condition="'%(Extension)' == '.vcxproj'" />
      <_OdinOdinRef Update="@(_OdinOdinRef)" Condition="'%(_OdinOdinRef.ReferenceKind)' == ''" ReferenceKind="Source" />
      <_OdinNativeRef Update="@(_OdinNativeRef)" Condition="'%(_OdinNativeRef.ReferenceKind)' == ''" ReferenceKind="Link" />
    </ItemGroup>
  </Target>

  <Target Name="OdinGetReferenceInfo" DependsOnTargets="_OdinClassifyReferences" Returns="@(OdinReferenceNode)">
    <MSBuild Projects="@(_OdinOdinRef)" Targets="OdinGetReferenceInfo" Condition="'@(_OdinOdinRef)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_OdinNestedNode" />
    </MSBuild>
    <MSBuild Projects="@(_OdinNativeRef)" Targets="GetTargetPath" Condition="'@(_OdinNativeRef)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_OdinNativeOutput" />
    </MSBuild>
    <ItemGroup>
      <!-- A native DLL is linked through its import library, which sits next to it. -->
      <OdinReferenceNode Include="%(_OdinNativeOutput.MSBuildSourceProjectFile)">
        <Name>$([System.IO.Path]::GetFileNameWithoutExtension('%(_OdinNativeOutput.MSBuildSourceProjectFile)'))</Name>
        <IsNative>true</IsNative>
        <LinkLibrary Condition="'%(_OdinNativeOutput.Extension)' == '.dll'">$([System.IO.Path]::ChangeExtension('%(_OdinNativeOutput.FullPath)', '.lib'))</LinkLibrary>
        <LinkLibrary Condition="'%(_OdinNativeOutput.Extension)' != '.dll'">%(_OdinNativeOutput.FullPath)</LinkLibrary>
      </OdinReferenceNode>
      <OdinReferenceNode Include="@(_OdinNestedNode)" />
      <OdinReferenceNode Include="$(MSBuildProjectFullPath)">
        <Name>$(MSBuildProjectName)</Name>
        <CollectionName>$(OdinCollectionName)</CollectionName>
        <CollectionRoot>$(OdinCollectionRoot)</CollectionRoot>
        <LinkLibrary>$(OdinLinkLibrary)</LinkLibrary>
        <IsNative>false</IsNative>
        <References>@(_OdinOdinRef->'%(ReferenceKind)|%(FullPath)');@(_OdinNativeRef->'%(ReferenceKind)|%(FullPath)')</References>
        <Sources>@(OdinCompile->'%(FullPath)')</Sources>
      </OdinReferenceNode>
    </ItemGroup>
  </Target>

  <!-- CPS reads the resolved project references (Dependencies node, Add Reference) from these design-time targets; for Odin a reference
       resolves to the referenced project itself. -->
  <Target Name="ResolveProjectReferencesDesignTime" Returns="@(_OdinResolvedProjectReference)">
    <ItemGroup>
      <_OdinResolvedProjectReference Include="%(ProjectReference.FullPath)">
        <OriginalItemSpec>%(ProjectReference.Identity)</OriginalItemSpec>
        <OriginalProjectReferenceItemSpec>%(ProjectReference.Identity)</OriginalProjectReferenceItemSpec>
      </_OdinResolvedProjectReference>
    </ItemGroup>
  </Target>
  <Target Name="ResolveProjectReferencesDesignTime2" DependsOnTargets="ResolveProjectReferencesDesignTime" Returns="@(_OdinResolvedProjectReference)" />

  <!-- Link references must exist before this project links; Source references never need building. -->
  <Target Name="OdinBuildLinkReferences" DependsOnTargets="_OdinClassifyReferences">
    <ItemGroup>
      <_OdinLinkRef Include="@(_OdinOdinRef->WithMetadataValue('ReferenceKind', 'Link'));@(_OdinNativeRef->WithMetadataValue('ReferenceKind', 'Link'))" />
    </ItemGroup>
    <MSBuild Projects="@(_OdinLinkRef)" Targets="Build" Condition="'@(_OdinLinkRef)' != ''" />
  </Target>

  <Target Name="OdinResolveReferences" DependsOnTargets="OdinBuildLinkReferences;OdinGetReferenceInfo">
    <OdinResolveReferences ProjectPath="$(MSBuildProjectFullPath)" Nodes="@(OdinReferenceNode)">
      <Output TaskParameter="Collections" ItemName="OdinCollection" />
      <Output TaskParameter="LinkInputs" ItemName="OdinLinkInput" />
      <Output TaskParameter="Sources" ItemName="OdinReferencedSource" />
    </OdinResolveReferences>
  </Target>

  <!-- Inputs are the project's own file list, the sources of Source-referenced projects (a consumer recompiles them), Link inputs and
       the project file (a flag change in the .odinproj must rebuild; a /p: override does not). -->
  <Target Name="_OdinCheckOutputType">
    <Error Condition="'$(OdinOutputType)' != 'Exe' and '$(OdinOutputType)' != 'Dll' and '$(OdinOutputType)' != 'Lib'"
           Code="ODIN0106" Text="OdinOutputType '$(OdinOutputType)' is not valid. Use Exe, Dll or Lib." />
  </Target>

  <Target Name="Build" DependsOnTargets="_OdinCheckOutputType;OdinResolveReferences" Inputs="@(OdinCompile);@(OdinReferencedSource);@(OdinLinkInput);$(MSBuildProjectFullPath)" Outputs="$(TargetPath);@(_OdinPdbOutput);@(_OdinImportLibOutput)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(TargetPath)'))" />
    <OdinBuild OdinExe="$(OdinExe)"
               PackageDirectory="$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(OdinPackageDir)'))"
               WorkingDirectory="$(MSBuildProjectDirectory)"
               OutputPath="$(TargetPath)"
               OutputType="$(OdinOutputType)"
               Debug="$(OdinDebug)"
               Collections="@(OdinCollection)"
               LinkInputs="@(OdinLinkInput)"
               ExtraArguments="$(OdinExtraArgs)" />
    <!-- A DLL linked through its import library must sit next to the exe at run time (what a C++ project reference does as "copy local"). -->
    <ItemGroup>
      <_OdinRuntimeDll Include="@(OdinLinkInput->WithMetadataValue('Extension', '.lib')->'%(RootDir)%(Directory)%(Filename).dll')" />
      <_OdinRuntimeDll Remove="@(_OdinRuntimeDll)" Condition="!Exists('%(_OdinRuntimeDll.FullPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_OdinRuntimeDll)" DestinationFolder="$([System.IO.Path]::GetDirectoryName('$(TargetPath)'))" SkipUnchangedFiles="true" Condition="'@(_OdinRuntimeDll)' != ''" />
  </Target>

  <Target Name="Clean">
    <Delete Files="$(TargetPath);$(_OdinPdbPath);@(_OdinImportLibOutput)" />
  </Target>

  <Target Name="Rebuild" DependsOnTargets="Clean;Build" />

  <ItemGroup>
    <PropertyPageSchema Include="$(OdinRulesDir)OdinProjectItemsSchema.xaml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(OdinRulesDir)OdinGeneral.BrowseObject.xaml">
      <Context>BrowseObject</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(OdinRulesDir)OdinCollections.xaml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <!-- Debug selection: VS's own DebuggerGeneralProperties rule (holds DebuggerFlavor) plus our debugger rule. -->
    <PropertyPageSchema Include="$(MSBuildExtensionsPath)\Microsoft\VisualStudio\Managed\DebuggerGeneral.xaml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(OdinRulesDir)OdinDebugger.xaml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(OdinRulesDir)OdinCompile.xaml">
      <Context>File</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(OdinRulesDir)OdinCompile.BrowseObject.xaml">
      <Context>BrowseObject</Context>
    </PropertyPageSchema>
    <!-- VS's own rules for ProjectReference items and their resolved form. -->
    <PropertyPageSchema Include="$(MSBuildExtensionsPath)\Microsoft\VisualStudio\Managed\ProjectReference.xaml">
      <Context>Project;BrowseObject</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildExtensionsPath)\Microsoft\VisualStudio\Managed\ResolvedProjectReference.xaml">
      <Context>ProjectSubscriptionService;BrowseObject</Context>
    </PropertyPageSchema>
  </ItemGroup>
</Project>
