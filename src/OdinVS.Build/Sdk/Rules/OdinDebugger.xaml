<?xml version="1.0" encoding="utf-8"?>
<!-- Debugger "page" selected through the DebuggerFlavor property; its Name must equal [ExportDebugger("OdinDebugger")]. -->
<Rule Name="OdinDebugger"
      DisplayName="Start"
      PageTemplate="Debugger"
      Description="Odin debugging options"
      xmlns="http://schemas.microsoft.com/build/2009/properties">
  <Rule.DataSource>
    <DataSource Persistence="ProjectFile"
                HasConfigurationCondition="False"
                SourceOfDefaultValue="AfterContext" />
  </Rule.DataSource>

  <!-- Defaults come from Sdk.targets; OdinDebugLaunchProvider reads these evaluated values at launch. -->
  <StringProperty Name="LocalDebuggerCommandArguments"
                  DisplayName="Command Arguments"
                  Description="Arguments passed to the program."
                  Category="General" />
  <StringProperty Name="LocalDebuggerWorkingDirectory"
                  DisplayName="Working Directory"
                  Description="Working directory of the program. Defaults to the project directory."
                  Subtype="folder"
                  Category="General" />
</Rule>
