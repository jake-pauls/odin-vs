<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OdinVS.Core.Tests" />
    <InternalsVisibleTo Include="OdinVS.LanguageServer" />
    <InternalsVisibleTo Include="OdinVS.ProjectSystem" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile-only: the OdinBuild task runs inside the host MSBuild, which supplies these assemblies. -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.11.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
