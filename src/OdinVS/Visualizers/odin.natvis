<?xml version="1.0" encoding="utf-8"?>
<!-- Odin types as the Odin compiler names them in the PDB: composite types keep their Odin names ("string", "[]int",
     "[dynamic]string"); scalars come out as C types (int is __int64) and cannot be renamed from here.
     Only "string" is covered: natvis rejects type names that do not parse as C++ ("Invalid type name '[]int'", also for
     '*]int', '[]*' and '*'), so slices and dynamic arrays cannot be matched (Exp 18.11, Natvis diagnostics, see docs/milestones.md, M5). -->
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <!-- Natvis is global to the debugger: this entry applies to every debug session, not only Odin ones, so it could also
       match a C/C++ type literally named "string" (untested; a mismatch would likely show an expression error on
       data/len). Scoping it to Odin sessions is an experiment in M5.5, see docs/milestones.md. -->
  <Type Name="string">
    <DisplayString>{data,[len]s8}</DisplayString>
    <StringView>data,[len]s8</StringView>
    <Expand>
      <Item Name="[len]">len</Item>
      <ArrayItems>
        <Size>len</Size>
        <ValuePointer>data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>
</AutoVisualizer>