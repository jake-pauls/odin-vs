<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>false</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeCopyLocalReferencesInVSIXContainer>false</IncludeCopyLocalReferencesInVSIXContainer>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OdinVS.LanguageServer\OdinVS.LanguageServer.csproj" />
    <ProjectReference Include="..\OdinVS.ProjectSystem\OdinVS.ProjectSystem.csproj" />
    <ProjectReference Include="..\OdinVS.Core\OdinVS.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="source.extension.vsixmanifest" />
    <Content Include="ols\ols.exe">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>ols\</VSIXSubPath>
    </Content>
    <Content Include="ols\builtin\*.odin">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>ols\builtin\</VSIXSubPath>
    </Content>
    <Content Include="odin.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Grammars\odin.tmLanguage.json">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>Grammars\</VSIXSubPath>
    </Content>
    <Content Include="Grammars\language-configuration.json">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>Grammars\</VSIXSubPath>
    </Content>
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Templates\ProjectTemplates\**\*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>ProjectTemplates\%(RecursiveDir)</VSIXSubPath>
    </Content>
    <Content Include="Templates\ItemTemplates\**\*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>ItemTemplates\%(RecursiveDir)</VSIXSubPath>
    </Content>
    <None Include="Grammars\README.md" />
    <None Include="ols\ols.pin" />
  </ItemGroup>
  <!-- The VSIX must not ship an ols.exe that differs from the one vetted for BundledOls.Version (see ols\ols.pin). -->
  <Target Name="VerifyBundledOls" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <OlsPinText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\ols\ols.pin'))</OlsPinText>
      <OlsPinnedHash>$([System.Text.RegularExpressions.Regex]::Replace('$(OlsPinText)', '(?s).*sha256=([0-9a-fA-F]{64}).*', '$1'))</OlsPinnedHash>
    </PropertyGroup>
    <GetFileHash Files="$(MSBuildProjectDirectory)\ols\ols.exe" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="OlsExeHash" />
    </GetFileHash>
    <PropertyGroup>
      <OlsActualHash>@(OlsExeHash->'%(FileHash)')</OlsActualHash>
    </PropertyGroup>
    <Error Condition="!$([System.String]::Equals('$(OlsActualHash)', '$(OlsPinnedHash)', System.StringComparison.OrdinalIgnoreCase))"
           Text="The bundled ols.exe (SHA-256 $(OlsActualHash)) does not match the pin in src\OdinVS\ols\ols.pin ($(OlsPinnedHash)). If you replaced ols.exe on purpose, run scripts\bump-ols.ps1; otherwise restore the file." />
  </Target>
</Project>
