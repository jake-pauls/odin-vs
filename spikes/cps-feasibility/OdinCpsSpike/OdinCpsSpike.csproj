<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup>
    <CpsDir>C:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE\CommonExtensions\Microsoft\Project\</CpsDir>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
    <!-- CPS assemblies come from the VS install (public NuGet packages stop at 17.9.380); never ship them. -->
    <Reference Include="Microsoft.VisualStudio.ProjectSystem">
      <HintPath>$(CpsDir)Microsoft.VisualStudio.ProjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.ProjectSystem.VS">
      <HintPath>$(CpsDir)Microsoft.VisualStudio.ProjectSystem.VS.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- CPS 18.x is built against System.Collections.Immutable 10.0; the VS SDK 17.14 packages bring 9.0. Compile against VS's copy. -->
    <PackageReference Include="System.Collections.Immutable" Version="9.0.0" ExcludeAssets="compile;runtime" />
    <Reference Include="System.Collections.Immutable">
      <HintPath>C:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE\CommonExtensions\Microsoft\VBCSharp\LanguageServices\InteractiveHost\Desktop\System.Collections.Immutable.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>
  <ItemGroup>
    <None Include="source.extension.vsixmanifest" />
    <Content Include="OdinCps.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Templates\ProjectTemplates\**\*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>ProjectTemplates\%(RecursiveDir)</VSIXSubPath>
    </Content>
    <Content Include="Templates\ItemTemplates\**\*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>ItemTemplates\%(RecursiveDir)</VSIXSubPath>
    </Content>
  </ItemGroup>
</Project>
