<Project>
  <!-- B1 spike: design-time wiring CPS needs for a custom project type.
       The BrowseObject rule is what fixes "missing some critical imports": CPS throws that error when no
       PropertyPageSchema with Context BrowseObject exists (see PhysicalProjectTreeProvider.GetProjectRootProperties). -->
  <PropertyGroup>
    <OdinRulesDir>$(MSBuildThisFileDirectory)Rules\</OdinRulesDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectCapability Include="OdinProject" />
    <ProjectCapability Include="ProjectConfigurationsDeclaredAsItems" />
    <!-- C# declares this so CPS tracks glob-included files and re-evaluates when files change on disk. -->
    <ProjectCapability Include="UseFileGlobs" />
  </ItemGroup>

  <ItemGroup>
    <PropertyPageSchema Include="$(OdinRulesDir)OdinProjectItemsSchema.xaml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(OdinRulesDir)OdinGeneral.BrowseObject.xaml">
      <Context>BrowseObject</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(OdinRulesDir)OdinCompile.xaml">
      <Context>File</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(OdinRulesDir)OdinCompile.BrowseObject.xaml">
      <Context>BrowseObject</Context>
    </PropertyPageSchema>
  </ItemGroup>
</Project>
