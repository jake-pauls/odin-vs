<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Local development only: Odin.Sdk must not leave this machine until the user says otherwise.
       <clear/> drops nuget.org for restore; defaultPushSource makes a bare `dotnet nuget push` land in the local feed. -->
  <packageSources>
    <clear />
    <add key="local-odin" value="feed" />
  </packageSources>
  <config>
    <add key="defaultPushSource" value="feed" />
  </config>
</configuration>
